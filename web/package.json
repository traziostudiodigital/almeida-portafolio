{
  "name": "almeida-portafolio",
  "version": "1.0.0",
  "description": "Portfolio web de Luis Manuel Almeida - Perito Tasador y Valuador de Obras de Arte",
  "scripts": {
    "build": "node compilar.js",
    "dev": "node compilar.js --watch",
    "compile": "npx tailwindcss -i ./assets/css/input.css -o ./output.css --minify",
